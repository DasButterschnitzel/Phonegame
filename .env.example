# The web bundle never contains ad IDs. AdMob configuration is read by Gradle per build type
# (android/app/admob.gradle, docs/ADMOB_TESTING.md) — set these in the shell or as CI secrets, never in a committed file:
#
# Debug APKs always use Google's demo units, whatever is set here.
# Release builds:
# ADMOB_MODE=test                     # test (default) | production | disabled  (ADMOB_REAL=true means production)
# ADMOB_APP_ID_ANDROID=ca-app-pub-xxxxxxxxxxxxxxxx~xxxxxxxxxx
# ADMOB_ANDROID_REWARDED=ca-app-pub-xxxxxxxxxxxxxxxx/xxxxxxxxxx
# ADMOB_ANDROID_INTERSTITIAL=ca-app-pub-xxxxxxxxxxxxxxxx/xxxxxxxxxx
# Optional per-placement rewarded units (default: all placements share ADMOB_ANDROID_REWARDED):
# ADMOB_ANDROID_REWARDED_BOOST=     # income ×2, autopilot
# ADMOB_ANDROID_REWARDED_UPGRADE=   # free upgrade, free tornado
# ADMOB_ANDROID_REWARDED_BONUS=     # offline ×3, lucky bug ×3, farm complete ×2, daily ×2
# Optional, any build: hashed test device IDs from logcat ("Use RequestConfiguration...setTestDeviceIds")
# ADMOB_TEST_DEVICE_IDS=
# Debug builds only: simulate the consent region (eea | not_eea)
# ADMOB_UMP_DEBUG_GEOGRAPHY=
