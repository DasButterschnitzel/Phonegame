# Real AdMob IDs are injected at build time (CI secrets). When unset, Google's test IDs are used.
# VITE_ADMOB_REAL=true
# VITE_ADMOB_ANDROID_REWARDED=ca-app-pub-xxxxxxxxxxxxxxxx/xxxxxxxxxx
# VITE_ADMOB_ANDROID_INTERSTITIAL=ca-app-pub-xxxxxxxxxxxxxxxx/xxxxxxxxxx
# VITE_ADMOB_IOS_REWARDED=ca-app-pub-xxxxxxxxxxxxxxxx/xxxxxxxxxx
# VITE_ADMOB_IOS_INTERSTITIAL=ca-app-pub-xxxxxxxxxxxxxxxx/xxxxxxxxxx
# Gradle (native app id, not a VITE_ var):
# ADMOB_APP_ID_ANDROID=ca-app-pub-xxxxxxxxxxxxxxxx~xxxxxxxxxx
